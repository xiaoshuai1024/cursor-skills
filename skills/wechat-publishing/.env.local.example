# 公众号发布环境变量（复制为 .env.local 填你的值，gitignore 此文件）
SITE_BASE_URL=https://your-blog.com/
SITE_NAME_SUFFIX= - 你的博客名
WECHAT_AUTHOR=你的公众号名
# 合集 id 从公众号后台→合集管理获取；格式 JSON
WECHAT_ALBUMS={"AI":{"id":"你的合集id","title":"AI"}}
WECHAT_DEFAULT_ALBUM=AI
# masssend 指纹：微信会轮换，跑 schedule_ui_v2 --capture-only 重抓
WECHAT_FINGERPRINT=你的指纹
